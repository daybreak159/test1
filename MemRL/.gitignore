/使用说明.md
*.log
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.bak-*

# Tests and historical baseline material stay local for this source handoff.
/tests/
/baselines/

# Only the agreed training and preprocessing entry points are included.
/scripts/*
!/scripts/memrl.sh
!/scripts/run_hf_orm.py
!/scripts/run_text_e_sft.py
!/scripts/run_u_sft.py
!/scripts/compact_swe_hybrid.py
