# Source-only GitHub scope. Tracked files and old commits are not removed by
# ignore rules; the initial history import must use the agreed source allowlist.

# Python environments, caches and build products.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
/.test-tmp/
/.venv/
/venv/
/build/
/dist/
*.egg-info/

# Development scratch space: only its guide is versioned.
/_dev/*
!/_dev/README.md

# Local data, model assets and experiment/deployment outputs.
/data/
/cache/
/runs/
/outputs/
/results/
/checkpoints/
/models/
/logs/
/diagnostics/
